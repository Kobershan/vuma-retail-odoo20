<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Privilege (sidebar section) -->
    <record model="res.groups.privilege" id="vuma_groups_privilege">
        <field name="name">Vuma Cross-Company</field>
        <field name="sequence">5</field>
        <field name="category_id" ref="base.module_category_sales"/>
    </record>

    <!-- Groups -->
    <record id="group_vuma_mixed_basket_user" model="res.groups">
        <field name="name">Mixed Basket User (Trade Rite + Siyaya DC)</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="vuma_groups_privilege"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman')),
                                        (4, ref('base.group_multi_company'))]"/>
        <field name="comment">Works on Trade Rite and Siyaya DC from one screen: mixed quotes auto-split on confirm, cash collected for both companies, invoices credited across both companies.</field>
    </record>

    <record id="group_vuma_mixed_basket_manager" model="res.groups">
        <field name="name">Mixed Basket Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="vuma_groups_privilege"/>
        <field name="implied_ids" eval="[(4, ref('group_vuma_mixed_basket_user')),
                                        (4, ref('sales_team.group_sale_manager'))]"/>
        <field name="comment">Manager access to mixed-basket configuration.</field>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

</odoo>