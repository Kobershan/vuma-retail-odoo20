<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ============================================================
             Sale Order form: stock-source column ALWAYS visible on
             draft/quotes + mixed basket page + split actions.
             NOTE: context flag ensures the product dropdown searches
             BOTH companies' products when the quote is mixed.

             `column_invisible` is decided once for the whole list, against
             the list's eval context, which holds the context, the user and the
             parent record and nothing else. It cannot see a column's own field,
             so `not vuma_source_company_id` would throw a NameError and take
             the whole order form down with it. Hence `parent.`, which is the
             record the columns actually vary with: on a single-company quote
             there is no stock source to show.
             ============================================================ -->
        <record id="view_sale_order_form_split" model="ir.ui.view">
            <field name="name">sale.order.form.vuma.split</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <!-- order_line context: mixed flag from the record -->
                <xpath expr="//field[@name='order_line']" position="attributes">
                    <attribute name="context">
                        {'vuma_mixed_basket': vuma_is_mixed_basket}
                    </attribute>
                </xpath>

                <!-- Stock-source column right after the product column -->
                <xpath expr="//list[@name='sol_list']/column[@name='product_and_description']" position="after">
                    <field name="vuma_source_company_id"
                           string="Stock Source"
                           widget="badge"
                           required="parent.vuma_is_mixed_basket"
                           decoration-info="vuma_source_company_id.name == 'Trade Rite'"
                           decoration-warning="vuma_source_company_id.name == 'Siyaya DC'"
                           decoration-danger="not vuma_source_company_id and product_id"
                           options="{'no_quick_create': True}"/>
                    <field name="vuma_source_location_id"
                           string="Stock Location"
                           optional="show"
                           column_invisible="not parent.vuma_is_mixed_basket"
                           options="{'no_quick_create': True}"/>
                    <field name="vuma_source_available_qty"
                           string="Available"
                           optional="show"
                           column_invisible="not parent.vuma_is_mixed_basket"/>
                </xpath>

                <xpath expr="//header" position="inside">
                    <button name="action_view_split_quotes" type="object"
                            string="View Split Quotes" invisible="not vuma_is_mixed_basket"/>
                    <button name="action_view_untraced_lines" type="object"
                            string="Fix Stock Source"
                            invisible="not vuma_untraced_line_ids"/>
                    <button name="action_new_mixed_basket" type="object"
                            string="New Mixed Basket"
                            groups="vuma_multi_tenant.group_vuma_mixed_basket_user"/>
                </xpath>
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_view_split_quotes" type="object" icon="fa-sitemap"
                            string="Both Companies" invisible="not vuma_is_mixed_basket"/>
                    <button name="action_view_untraced_lines" type="object" icon="fa-exclamation-triangle"
                            string="No Stock Source" invisible="not vuma_untraced_line_ids"/>
                    <button name="action_view_original_mixed_quote" type="object" icon="fa-compress"
                            string="Origin" invisible="not vuma_original_mixed_quote_id"/>
                </xpath>

                <!-- Which company's stock this quote uses -->
                <xpath expr="//field[@name='partner_id']" position="before">
                    <field name="vuma_source_company_summary" readonly="1"
                           invisible="not vuma_source_company_summary"
                           placeholder="No stock source assigned yet"/>
                </xpath>
            </field>
        </record>

        <!-- Stock source list view (fixing unassigned lines) -->
        <record id="view_sale_order_line_list_vuma_source" model="ir.ui.view">
            <field name="name">sale.order.line.list.vuma.source</field>
            <field name="model">sale.order.line</field>
            <field name="arch" type="xml">
                <list string="Lines — Stock Source" create="false">
                    <field name="order_id"/>
                    <field name="product_id"/>
                    <field name="vuma_source_company_id" widget="badge"
                           decoration-info="vuma_source_company_id.name == 'Trade Rite'"
                           decoration-warning="vuma_source_company_id.name == 'Siyaya DC'"
                           decoration-danger="not vuma_source_company_id"
                           options="{'no_quick_create': True}"/>
                    <field name="vuma_source_location_id"/>
                    <field name="vuma_source_available_qty"/>
                    <field name="product_uom_qty"/>
                    <field name="price_unit"/>
                </list>
            </field>
        </record>

        <!-- Mixed basket info + visible flag fields (form extras) -->
        <record id="view_sale_order_form_mixed_info" model="ir.ui.view">
            <field name="name">sale.order.form.vuma.info</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="Mixed Basket"
                          invisible="not vuma_is_mixed_basket and not vuma_original_mixed_quote_id">
                        <group>
                            <field name="vuma_is_mixed_basket" readonly="1" force_save="1"/>
                            <field name="vuma_original_mixed_quote_id" readonly="1"/>
                            <field name="vuma_split_quote_trade_rite_id" readonly="1"/>
                            <field name="vuma_split_quote_siyaya_dc_id" readonly="1"/>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>

        <!-- Quotation list: company column shown when both allowed -->
        <record id="view_sale_quotation_list_comp" model="ir.ui.view">
            <field name="name">sale.order.list.vuma.company</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_quotation_tree_with_onboarding"/>
            <field name="arch" type="xml">
                <xpath expr="(//field[@name='company_id'])[2]" position="attributes">
                    <attribute name="optional">show</attribute>
                    <attribute name="widget">badge</attribute>
                </xpath>
                <xpath expr="//list" position="inside">
                    <field name="vuma_is_mixed_basket" optional="hide"/>
                </xpath>
            </field>
        </record>

        <record id="view_sale_order_list_comp" model="ir.ui.view">
            <field name="name">sale.order.list.vuma.company.2</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_tree"/>
            <field name="arch" type="xml">
                <xpath expr="(//field[@name='company_id'])[2]" position="attributes">
                    <attribute name="optional">show</attribute>
                </xpath>
            </field>
        </record>

        <!-- Search: group / filter by company across both -->
        <record id="view_sale_order_search_comp" model="ir.ui.view">
            <field name="name">sale.order.search.vuma.company</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.sale_order_view_search_inherit_sale"/>
            <field name="arch" type="xml">
                <xpath expr="//search" position="inside">
                    <filter name="group_company" string="Group by Company"
                            context="{'group_by': 'company_id'}"/>
                    <filter name="only_mixed" string="Mixed Baskets"
                            domain="[('vuma_is_mixed_basket', '=', True)]"/>
                </xpath>
            </field>
        </record>

        <!-- ============================================================
             Invoices list: company visible
             ============================================================ -->
        <record id="view_account_move_list_comp" model="ir.ui.view">
            <field name="name">account.move.tree.vuma.company</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_tree"/>
            <field name="arch" type="xml">
                <xpath expr="(//field[@name='company_id'])[1]" position="attributes">
                    <attribute name="optional">show</attribute>
                    <attribute name="widget">badge</attribute>
                </xpath>
            </field>
        </record>
        <record id="view_account_move_list_comp_cust" model="ir.ui.view">
            <field name="name">account.move.tree.customer.vuma.company</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_invoice_tree"/>
            <field name="arch" type="xml">
                <xpath expr="(//field[@name='company_id'])[2]" position="attributes">
                    <attribute name="optional">show</attribute>
                    <attribute name="widget">badge</attribute>
                </xpath>
            </field>
        </record>
        <record id="view_account_move_search_comp" model="ir.ui.view">
            <field name="name">account.move.search.vuma.company</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_account_invoice_filter"/>
            <field name="arch" type="xml">
                <xpath expr="//search" position="inside">
                    <filter name="group_company" string="Group by Company"
                            context="{'group_by': 'company_id'}"/>
                </xpath>
            </field>
        </record>

        <!-- ============================================================
             Payments list: company visible
             ============================================================ -->
        <record id="view_account_payment_list_comp" model="ir.ui.view">
            <field name="name">account.payment.tree.vuma.company</field>
            <field name="model">account.payment</field>
            <field name="inherit_id" ref="account.view_account_payment_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='company_id']" position="attributes">
                    <attribute name="optional">show</attribute>
                    <attribute name="widget">badge</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>