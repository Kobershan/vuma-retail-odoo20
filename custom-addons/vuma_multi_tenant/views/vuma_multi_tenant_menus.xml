<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- ================= top-level cross-company hub ================= -->
        <menuitem id="menu_vuma_root"
            name="Vuma Cross-Company"
            sequence="15"
            groups="vuma_multi_tenant.group_vuma_mixed_basket_user"
           />

        <menuitem id="menu_vuma_operations"
            name="Operations" parent="menu_vuma_root" sequence="10"/>

        <!--
            The standard Odoo sales and invoicing actions carry hidden default
            filters:

              * Quotations      -> search_default_my_quotation (only mine)
              * Sales Orders    -> search_default_sales (confirmed only)
              * Invoices        -> search_default_out_invoice / out_receipt
              * Journal Entries -> search_default_posted (posted only)

            Those defaults are fine for a single-user desktop, but in this
            shared back office they make a record created by somebody else
            disappear from the screen even after a refresh. These actions are
            deliberately unfiltered; users can still add the standard filters
            from the search bar when they want them.
        -->
        <record id="action_vuma_all_quotations" model="ir.actions.act_window">
            <field name="name">Quotations</field>
            <field name="path">vuma-quotations</field>
            <field name="res_model">sale.order</field>
            <field name="view_mode">list,kanban,form,calendar,pivot,graph,activity</field>
            <field name="view_id" ref="sale.view_quotation_tree_with_onboarding"/>
            <field name="search_view_id" ref="sale.sale_order_view_search_inherit_quotation"/>
            <field name="domain">[('state', 'in', ['draft', 'sent'])]</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Every quotation in the active company scope, including drafts created by other users.
                </p>
            </field>
        </record>

        <record id="action_vuma_all_sales_orders" model="ir.actions.act_window">
            <field name="name">Sales Orders</field>
            <field name="path">vuma-sales-orders</field>
            <field name="res_model">sale.order</field>
            <field name="view_mode">list,kanban,form,calendar,pivot,graph,activity</field>
            <field name="view_id" ref="sale.view_quotation_tree_with_onboarding"/>
            <field name="search_view_id" ref="sale.sale_order_view_search_inherit_sale"/>
            <field name="domain">[('state', '!=', 'cancel')]</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Every sales order, draft or confirmed, in the active company scope.
                </p>
            </field>
        </record>

        <record id="action_vuma_all_customer_invoices" model="ir.actions.act_window">
            <field name="name">Customer Invoices</field>
            <field name="path">vuma-customer-invoices</field>
            <field name="res_model">account.move</field>
            <field name="view_mode">list,kanban,form,pivot,graph,activity</field>
            <field name="view_id" ref="account.view_out_invoice_tree"/>
            <field name="search_view_id" ref="account.view_account_invoice_filter"/>
            <field name="domain">[('move_type', 'in', ['out_invoice', 'out_refund', 'out_receipt'])]</field>
            <field name="context">{'default_move_type': 'out_invoice'}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Every customer invoice, credit note and receipt in the active company scope.
                </p>
            </field>
        </record>

        <record id="action_vuma_all_payments" model="ir.actions.act_window">
            <field name="name">Payments</field>
            <field name="path">vuma-payments</field>
            <field name="res_model">account.payment</field>
            <field name="view_mode">list,kanban,form,graph,activity</field>
            <field name="view_id" ref="account.view_account_payment_tree"/>
            <field name="search_view_id" ref="account.view_account_payment_search"/>
            <field name="domain">[]</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Every customer and supplier payment in the active company scope.
                </p>
            </field>
        </record>

        <record id="action_vuma_all_vendor_bills" model="ir.actions.act_window">
            <field name="name">Vendor Bills</field>
            <field name="path">vuma-vendor-bills</field>
            <field name="res_model">account.move</field>
            <field name="view_mode">list,kanban,form,pivot,graph,activity</field>
            <field name="view_id" ref="account.view_in_invoice_bill_tree"/>
            <field name="search_view_id" ref="account.view_account_bill_filter"/>
            <field name="domain">[('move_type', 'in', ['in_invoice', 'in_refund', 'in_receipt'])]</field>
            <field name="context">{'default_move_type': 'in_invoice'}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Every vendor bill, refund and receipt in the active company scope.
                </p>
            </field>
        </record>

        <record id="action_vuma_all_journal_entries" model="ir.actions.act_window">
            <field name="name">Journal Entries</field>
            <field name="path">vuma-journal-entries</field>
            <field name="res_model">account.move</field>
            <field name="view_mode">list,kanban,form,pivot,graph,activity</field>
            <field name="view_id" ref="account.view_move_tree"/>
            <field name="search_view_id" ref="account.view_account_move_filter"/>
            <field name="domain">[('move_type', '=', 'entry')]</field>
            <field name="context">{'default_move_type': 'entry'}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Every journal entry, draft or posted, in the active company scope.
                </p>
            </field>
        </record>

        <record id="action_vuma_all_journal_items" model="ir.actions.act_window">
            <field name="name">Journal Items</field>
            <field name="path">vuma-journal-items</field>
            <field name="res_model">account.move.line</field>
            <field name="view_mode">list,pivot,graph,kanban</field>
            <field name="view_id" ref="account.view_move_line_tree"/>
            <field name="domain">[('display_type', 'not in', ('line_section', 'line_subsection', 'line_note')), ('parent_state', '!=', 'cancel')]</field>
            <field name="context">{'journal_type': 'general'}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Journal items from draft and posted entries in the active company scope.
                </p>
            </field>
        </record>

        <menuitem id="menu_vuma_link_quote" name="Quotations"
            parent="menu_vuma_operations" action="vuma_multi_tenant.action_vuma_all_quotations"
            sequence="10"/>

        <menuitem id="menu_vuma_link_orders" name="Sales Orders"
            parent="menu_vuma_operations" action="vuma_multi_tenant.action_vuma_all_sales_orders"
            sequence="15"/>

        <menuitem id="menu_vuma_link_invoices" name="Customer Invoices"
            parent="menu_vuma_operations" action="vuma_multi_tenant.action_vuma_all_customer_invoices"
            sequence="20"/>

        <menuitem id="menu_vuma_link_payments" name="Payments"
            parent="menu_vuma_operations" action="vuma_multi_tenant.action_vuma_all_payments"
            sequence="25"/>

        <menuitem id="menu_vuma_all_vendor_bills" name="Vendor Bills"
            parent="menu_vuma_operations" action="vuma_multi_tenant.action_vuma_all_vendor_bills"
            sequence="27"/>

        <menuitem id="menu_vuma_all_journal_entries" name="Journal Entries"
            parent="menu_vuma_operations" action="vuma_multi_tenant.action_vuma_all_journal_entries"
            sequence="28"/>

        <menuitem id="menu_vuma_all_journal_items" name="Journal Items"
            parent="menu_vuma_operations" action="vuma_multi_tenant.action_vuma_all_journal_items"
            sequence="29"/>

        <menuitem id="menu_vuma_collect" name="Cash Collections"
            parent="menu_vuma_operations" action="vuma_multi_tenant.action_vuma_payment_session"
            sequence="30"/>

        <menuitem id="menu_vuma_credit" name="Credit Customer Invoices"
            parent="menu_vuma_operations" action="vuma_multi_tenant.action_vuma_partner_credit_wizard"
            sequence="35"/>

        <menuitem id="menu_vuma_stock_trace" name="Stock / Company Traceability"
            parent="menu_vuma_operations" action="vuma_multi_tenant.action_vuma_stock_trace"
            sequence="40"/>

        <menuitem id="menu_vuma_reporting" name="Reporting" parent="menu_vuma_root" sequence="20"/>
        <menuitem id="menu_vuma_sales_analysis" name="Sales Analysis (Both Companies)"
            parent="menu_vuma_reporting" action="sale.action_order_report_all"
            sequence="10"/>

        <!-- ================= Sequences for the session ================= -->
        <record id="seq_vuma_payment_session" model="ir.sequence">
            <field name="name">Cross-Company Cash Collection</field>
            <field name="code">vuma.payment.session</field>
            <field name="prefix">VCC/</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>