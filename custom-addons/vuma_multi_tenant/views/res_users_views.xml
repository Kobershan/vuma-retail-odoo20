<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Res Users Form View - Add Mixed Basket Fields -->
        <record id="view_res_users_form_inherit_vuma_mixed_basket" model="ir.ui.view">
            <field name="name">res.users.form.inherit.vuma.mixed.basket</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='access_rights']" position="after">
                    <page string="Vuma Multi-Tenant" name="vuma_multi_tenant" groups="sales_team.group_sale_manager">
                        <group string="Mixed Basket Access">
                            <field name="vuma_mixed_basket_access"/>
                            <field name="vuma_default_mixed_basket_company_id"
                                   invisible="not vuma_mixed_basket_access"/>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>