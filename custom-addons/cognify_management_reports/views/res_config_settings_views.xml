<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_inherit_cognify_management" model="ir.ui.view">
        <field name="name">res.config.settings.inherit.cognify.management</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//block[@name='employees_setting_container']" position="after">
                <block title="Management Reports" name="cognify_management_setting_container">
                    <setting id="cognify_dead_stock_days"
                             string="Dead Stock After"
                             help="Days without a sale before stock still on hand counts as dead. This drives the dead and low flags on Stock Health and the Dead and Slow Moving Stock report.">
                        <div class="content-group">
                            <div class="row mt8">
                                <field name="cognify_dead_stock_days" class="o_light_label"/>
                                <span class="ms-2">days without a sale</span>
                            </div>
                        </div>
                    </setting>
                    <setting id="cognify_slow_stock_qty"
                             string="Slow Mover Threshold"
                             help="Fewer units sold over the dead stock period counts as a slow mover.">
                        <div class="content-group">
                            <div class="row mt8">
                                <field name="cognify_slow_stock_qty" class="o_light_label"/>
                                <span class="ms-2">units</span>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>

        </field>
    </record>

</odoo>