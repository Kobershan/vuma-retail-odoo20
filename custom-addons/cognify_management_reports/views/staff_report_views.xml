<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==================== Staff hours and time off ==================== -->

    <record id="view_staff_report_list" model="ir.ui.view">
        <field name="name">cognify.staff.report.list</field>
        <field name="model">cognify.staff.report</field>
        <field name="arch" type="xml">
            <list string="Staff Hours and Time Off" default_order="month desc, employee_name">
                <field name="month"/>
                <field name="employee_name" string="Employee"/>
                <field name="department_id" optional="show"/>
                <field name="job_id" optional="hide"/>
                <field name="manager_id" optional="hide"/>
                <field name="shifts" string="Shifts" optional="hide"/>
                <field name="days_present" sum="Days Present"/>
                <field name="hours_worked" sum="Hours Worked"/>
                <field name="avg_hours" string="Avg Day" optional="hide"/>
                <field name="overtime_hours" sum="Overtime"
                       decoration-warning="overtime_hours &gt; 0" optional="show"/>
                <field name="late_arrivals" sum="Late" optional="show"
                       decoration-danger="late_arrivals &gt; 3"/>
                <field name="annual_leave_taken" sum="Annual Leave" optional="show"/>
                <field name="sick_days_taken" sum="Sick Days" optional="show"/>
                <field name="short_paid_days" sum="Short Paid" optional="show"
                       decoration-warning="short_paid_days &gt; 0"
                       help="Time off booked against a type that costs the employee nothing. This is what the days beyond their allocation turn into."/>
                <field name="other_leave_taken" string="Other" optional="hide"/>
                <field name="leave_taken" sum="Total Time Off" optional="show"/>
                <field name="annual_entitlement" string="Entitlement" optional="show"/>
                <field name="annual_leave_cumulative" string="Annual To Date" optional="hide"/>
                <field name="leave_available" sum="Available"
                       decoration-danger="leave_available &lt; 0"
                       decoration-warning="leave_available &gt;= 0 and leave_available &lt; 5"/>
                <field name="leave_exhausted" string="Exhausted" optional="show"
                       decoration-danger="leave_exhausted == True"
                       help="No annual leave left for the year. Anything further has to be short paid or refused."/>
                <field name="leave_shortfall" sum="Shortfall" optional="show"
                       decoration-warning="leave_shortfall &gt; 0"
                       help="Annual leave already approved for the rest of the year that this year's entitlement cannot cover. It will have to be short paid."/>
                <field name="leave_booked" string="Booked Ahead" optional="show"/>
                <field name="sick_days_booked" optional="hide"/>
                <field name="earliest_in" optional="hide"/>
                <field name="latest_out" optional="hide"/>
                <field name="employee_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_staff_report_pivot" model="ir.ui.view">
        <field name="name">cognify.staff.report.pivot</field>
        <field name="model">cognify.staff.report</field>
        <field name="arch" type="xml">
            <pivot string="Hours and Time Off" sample="1">
                <field name="employee_name" type="row"/>
                <field name="month" interval="month" type="col"/>
                <field name="hours_worked" type="measure"/>
                <field name="overtime_hours" type="measure"/>
                <field name="leave_taken" type="measure"/>
                <field name="short_paid_days" type="measure"/>
                <field name="leave_available" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_staff_report_graph" model="ir.ui.view">
        <field name="name">cognify.staff.report.graph</field>
        <field name="model">cognify.staff.report</field>
        <field name="arch" type="xml">
            <graph string="Hours Worked" type="bar">
                <field name="employee_name" type="row"/>
                <field name="hours_worked" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_staff_report_search" model="ir.ui.view">
        <field name="name">cognify.staff.report.search</field>
        <field name="model">cognify.staff.report</field>
        <field name="arch" type="xml">
            <search string="Staff Hours and Time Off">
                <field name="employee_name" string="Employee"/>
                <field name="department_id"/>
                <field name="manager_id"/>
                <field name="month"/>
                <filter name="filter_this_month" string="This month"
                        domain="[('month', '=', context_today().strftime('%Y-%m-01'))]"/>
                <filter name="filter_last_3_months" string="Last 3 months"
                        domain="[('month', '&gt;=', (context_today() - relativedelta(months=2)).strftime('%Y-%m-01'))]"/>
                <filter name="filter_this_year" string="This year"
                        domain="[('month', '&gt;=', context_today().strftime('%Y-01-01'))]"/>
                <separator/>
                <filter name="filter_overtime" string="Had overtime"
                        domain="[('overtime_hours', '&gt;', 0)]"/>
                <filter name="filter_no_leave_left" string="Leave used up"
                        domain="[('leave_available', '&lt;=', 0)]"/>
                <filter name="filter_low_leave" string="Less than 5 days left"
                        domain="[('leave_available', '&gt;', 0), ('leave_available', '&lt;', 5)]"/>
                <filter name="filter_short_paid" string="Short paid leave"
                        domain="[('short_paid_days', '&gt;', 0)]"/>
                <filter name="filter_shortfall" string="Approved leave over entitlement"
                        domain="[('leave_shortfall', '&gt;', 0)]"/>
                <separator/>
                <filter name="group_department" string="Department"
                        context="{'group_by': 'department_id'}"/>
                <filter name="group_employee" string="Employee"
                        context="{'group_by': 'employee_name'}"/>
            </search>
        </field>
    </record>

    <record id="action_staff_report" model="ir.actions.act_window">
        <field name="name">Staff Hours and Time Off</field>
        <field name="res_model">cognify.staff.report</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="context">{'search_default_filter_this_year': 1}</field>
    </record>

    <record id="action_staff_hours" model="ir.actions.act_window">
        <field name="name">Hours Worked</field>
        <field name="res_model">cognify.staff.report</field>
        <field name="view_mode">pivot,list,graph</field>
        <field name="context">{'search_default_filter_this_year': 1}</field>
    </record>

    <record id="action_staff_leave" model="ir.actions.act_window">
        <field name="name">Leave Taken and Available</field>
        <field name="res_model">cognify.staff.report</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="domain">[('leave_taken', '&gt;', 0)]</field>
    </record>

</odoo>