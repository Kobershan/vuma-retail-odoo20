<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Sales reports are pivots on sale.report, which Odoo already maintains
        as a view of every sale order line with revenue, cost and margin on it.
        Nothing here re-computes anything: the report is the same numbers the
        Sales list view shows, arranged the way a manager asks for them.

        Money comes from confirmed orders, so the default domain leaves out
        quotations. Actions that are about the pipeline filter for them instead.
    -->

    <record id="sale_report_view_pivot_month" model="ir.ui.view">
        <field name="name">cognify.sale.report.pivot.month</field>
        <field name="model">sale.report</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <pivot string="Sales by Month" sample="1">
                <field name="date" interval="month" type="col"/>
                <field name="price_subtotal" type="measure"/>
                <field name="margin" type="measure"/>
                <field name="margin_percent" type="measure"/>
                <field name="product_uom_qty" type="measure"/>
                <field name="name" type="row" invisible="True"/>
            </pivot>
        </field>
    </record>

    <record id="sale_report_view_pivot_day" model="ir.ui.view">
        <field name="name">cognify.sale.report.pivot.day</field>
        <field name="model">sale.report</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <pivot string="Sales by Day" sample="1">
                <field name="date" interval="day" type="col"/>
                <field name="price_subtotal" type="measure"/>
                <field name="product_uom_qty" type="measure"/>
                <field name="name" type="row" invisible="True"/>
            </pivot>
        </field>
    </record>

    <record id="sale_report_view_pivot_channel" model="ir.ui.view">
