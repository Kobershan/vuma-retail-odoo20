                               'pivot_row_group_by': ['product_id'],
                               'pivot_column_group_by': [],
                               'sale_report_order': 'price_subtotal asc'}</field>
    </record>

    <record id="action_sales_by_customer" model="ir.actions.act_window">
        <field name="name">Sales by Customer</field>
        <field name="res_model">sale.report</field>
        <field name="view_mode">pivot,graph,list</field>
