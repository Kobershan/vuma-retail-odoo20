    <record id="sale_report_view_graph_month" model="ir.ui.view">
        <field name="name">cognify.sale.report.graph.month</field>
        <field name="model">sale.report</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <graph string="Sales Trend" type="line">
                <field name="price_subtotal" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="sale_report_view_graph_category" model="ir.ui.view">
        <field name="name">cognify.sale.report.graph.category</field>
        <field name="model">sale.report</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <graph string="Sales by Category" type="pie">
                <field name="price_subtotal" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Saved searches shared by the actions below. -->
    <record id="sale_report_filter_confirmed" model="ir.filters">
        <field name="name">Confirmed only</field>
        <field name="model_id" ref="sale.model_sale_report"/>
        <field name="domain">[('state', 'not in', ['draft', 'sent', 'cancel'])]</field>
        <field name="context">{'group_by': []}</field>
    </record>

    <!-- ============================== Actions ============================== -->

    <record id="action_sales_overview" model="ir.actions.act_window">
        <field name="name">Sales Overview</field>
        <field name="res_model">sale.report</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="domain">[('state', 'not in', ['draft', 'sent', 'cancel'])]</field>
        <field name="context">{'search_default_sale_report_filter_confirmed': 1,
                               'pivot_measures': ['price_subtotal', 'margin', 'margin_percent'],
                               'pivot_row_group_by': ['date:month'],
                               'pivot_column_group_by': []}</field>
        <field name="views" eval="[(5, 0, 0)]"/>
    </record>

    <record id="action_sales_by_day" model="ir.actions.act_window">
        <field name="name">Sales by Day</field>
        <field name="res_model">sale.report</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="domain">[('state', 'not in', ['draft', 'sent', 'cancel'])]</field>
        <field name="context">{'pivot_measures': ['price_subtotal', 'product_uom_qty'],
                               'pivot_row_group_by': ['date:day'],
                               'pivot_column_group_by': [],
                               'graph_measure': 'price_subtotal'}</field>
    </record>

    <record id="action_sales_by_month" model="ir.actions.act_window">
        <field name="name">Sales by Month</field>
        <field name="res_model">sale.report</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="domain">[('state', 'not in', ['draft', 'sent', 'cancel'])]</field>
        <field name="context">{'pivot_measures': ['price_subtotal', 'margin', 'margin_percent', 'product_uom_qty'],
                               'pivot_row_group_by': ['date:month'],
                               'pivot_column_group_by': [],
                               'graph_measure': 'price_subtotal'}</field>
    </record>

    <record id="action_sales_by_channel" model="ir.actions.act_window">
        <field name="name">Sales by Channel</field>
        <field name="res_model">sale.report</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="domain">[('state', 'not in', ['draft', 'sent', 'cancel'])]</field>
        <field name="context">{'pivot_measures': ['price_subtotal', 'margin', 'margin_percent'],
                               'pivot_row_group_by': ['team_id'],
                               'pivot_column_group_by': ['date:month']}</field>
    </record>

    <record id="action_sales_by_category" model="ir.actions.act_window">
        <field name="name">Sales by Category</field>
        <field name="res_model">sale.report</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="domain">[('state', 'not in', ['draft', 'sent', 'cancel'])]</field>
        <field name="context">{'pivot_measures': ['price_subtotal', 'product_uom_qty', 'margin_percent'],
                               'pivot_row_group_by': ['categ_id'],
                               'pivot_column_group_by': ['date:month']}</field>
    </record>

    <record id="action_cost_of_sales" model="ir.actions.act_window">
        <field name="name">Cost of Sales and Margin</field>
        <field name="res_model">sale.report</field>
        <field name="view_mode">pivot,list,graph</field>
        <field name="domain">[('state', 'not in', ['draft', 'sent', 'cancel'])]</field>
        <field name="context">{'pivot_measures': ['price_subtotal', 'purchase_price', 'margin', 'margin_percent'],
                               'pivot_row_group_by': ['categ_id'],
                               'pivot_column_group_by': ['date:month']}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing to cost yet</p>
            <p>Cost of sales comes from each product's cost price as it was when
               the order was confirmed. Set a cost on a product, or use
               <em>Inventory → Products → Cost</em> and landed costs, and the
               margin fills in.</p>
        </field>
    </record>

    <record id="action_salesperson_performance" model="ir.actions.act_window">
        <field name="name">Salesperson by Month</field>
        <field name="res_model">sale.report</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="domain">[('state', 'not in', ['draft', 'sent', 'cancel'])]</field>
