<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Invoice form: the request toggle plus the captured signature. -->
    <record id="view_move_form_signature" model="ir.ui.view">
        <field name="name">account.move.form.signature</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_request_signature" type="object"
                        class="oe_stat_button" icon="fa-pencil"
                        groups="account.group_account_invoice"
                        invisible="not signature_requested or signature">
                    <field name="signature_requested" widget="statinfo"
                           string="Awaiting Signature"/>
                </button>
            </xpath>

            <!-- invoice_date appears twice (outgoing vs incoming), so target the
                 outgoing one explicitly or the xpath is ambiguous. -->
            <xpath expr="//field[@name='invoice_date'][@invisible=&quot;move_type not in ('out_invoice', 'out_refund', 'out_receipt')&quot;]"
                   position="after">
                <field name="signature_requested"
                       groups="account.group_account_invoice"
                       invisible="move_type not in ('out_invoice','out_refund')"/>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Customer Signature" name="customer_signature"
                      groups="account.group_account_invoice">
                    <group>
                        <group>
                            <field name="signed_by" readonly="1"/>
                            <field name="signed_on" readonly="1"/>
                        </group>
                        <group>
                            <button name="action_request_signature" type="object"
                                    string="Request Signature" class="btn-primary"
                                    invisible="signature"/>
                            <button name="action_open_signature_request" type="object"
                                    string="Open Customer Link"/>
                            <button name="action_revoke_signature" type="object"
                                    string="Revoke Signature"
                                    confirm="Clear this signature so the customer can sign again?"
                                    invisible="not signature"/>
                        </group>
                    </group>

                    <field name="signature_note"
                           placeholder="e.g. Please confirm receipt of these goods in good order."/>

                    <div class="mt-3">
                        <div class="text-muted mb-2" invisible="not signature">
                            Captured from the customer portal:
                        </div>
                        <field name="signature" widget="image" nolabel="1"
                               class="oe_inline"
                               options="{'size': [0, 160]}"
                               readonly="1"/>
                    </div>
                </page>
            </xpath>

        </field>
    </record>

    <!-- Show it in the list so office staff can see at a glance who has signed. -->
    <record id="view_move_list_signature" model="ir.ui.view">
        <field name="name">account.move.list.signature</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_tree"/>
        <field name="arch" type="xml">
            <field name="state" position="before">
                <field name="signed_by" optional="show"/>
                <field name="signature_requested" optional="hide"/>
            </field>
        </field>
    </record>

    <!-- Search: find invoices awaiting a signature. -->
    <record id="view_account_invoice_filter_signature" model="ir.ui.view">
        <field name="name">account.move.search.signature</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <search position="inside">                <filter name="awaiting_signature" string="Awaiting Signature"
                        domain="[('signature_requested','=',True),('signature','=',False)]"/>
                <filter name="signed" string="Signed"
                        domain="[('signature','!=',False)]"/>
            </search>
        </field>
    </record>

    <record id="action_invoices_awaiting_signature" model="ir.actions.act_window">
        <field name="name">Awaiting Signature</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_type','in',('out_invoice','out_refund')),('signature_requested','=',True),('signature','=',False)]</field>
        <field name="context">{'search_default_awaiting_signature': 1}</field>
    </record>

    <menuitem id="menu_invoices_awaiting_signature"
              name="Awaiting Signature"
              parent="account.menu_finance_receivables"
              action="action_invoices_awaiting_signature"
              groups="account.group_account_invoice"
              sequence="15"/>

</odoo>
