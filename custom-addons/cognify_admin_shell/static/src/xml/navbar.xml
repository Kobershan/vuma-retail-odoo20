<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

  <t t-inherit="web.NavBar" t-inherit-mode="extension">
    <!-- Inject sidebar toggle + current app name at the start of the navbar. -->
    <xpath expr="//nav" position="inside">
      <button class="vuma-navtoggle" t-on-click="this.onVumaToggleSidebar" title="Open navigation" aria-label="Open navigation">
        <i class="oi" data-icon="menu"/>
      </button>
      <div t-if="this.currentAppName" class="vuma-navtitle" t-out="this.currentAppName"/>
      <button class="vuma-navsearch" t-on-click="this.onVumaSearch" title="Search menus (Ctrl+K)" aria-label="Search menus">
        <i class="oi" data-icon="search"/>
        <span>Search…</span>
        <kbd>⌘K</kbd>
      </button>
    </xpath>
  </t>

  <!-- Override to prepend toggle on all sizes via JS-driven template? Use manual slot. -->
</templates>
