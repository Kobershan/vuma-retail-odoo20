<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =============================================== delivery document -->
    <template id="report_delivery_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="company" t-value="o.company_id"/>
                <t t-set="hide_recipient_address" t-value="True"/>
                <t t-set="layout_document_title" t-value="'Delivery Document'"/>

                <style>
                    .dd { font-size: 9pt; color: #111827; }
                    .dd .doc-ref { font-size: 14pt; font-weight: 700; color: #111827;
                                   line-height: 1.2; }
                    .dd .doc-sub { font-size: 8.5pt; color: #6b7280; line-height: 1.5; }
                    .dd .doc-meta { background: #f8fafc; border: 1px solid #e5e7eb;
                                    border-left: 3px solid #1d4ed8; padding: 8px 12px; }
                    .dd .doc-meta p { margin: 0 0 2px 0; font-size: 8.5pt; }
                    .dd .doc-meta .m-lbl { font-size: 7.5pt; font-weight: 700; color: #6b7280;
                                           text-transform: uppercase; letter-spacing: 1px; }

                    .dd .kpi td { background: #f8fafc; border: 1px solid #e5e7eb;
                                  padding: 8px 12px; width: 25%; }
                    .dd .kpi.has-pallets td { width: 20%; }
                    .dd .kpi .k-lbl { font-size: 7pt; font-weight: 700; color: #6b7280;
                                      text-transform: uppercase; letter-spacing: 1px; }
                    .dd .kpi .k-val { font-size: 12pt; font-weight: 700; color: #111827; }
                    .dd .kpi .k-val.pos { color: #15803d; }
                    .dd .kpi .k-val.neg { color: #b45309; }
                    .dd .kpi .k-sub { font-size: 7.5pt; color: #6b7280;
                                      line-height: 1.4; }

                    .dd table.grid { width: 100%; border-collapse: collapse; }
                    .dd table.grid thead th { background: #111827; color: #ffffff;
                                              font-size: 7.5pt; font-weight: 700;
                                              text-transform: uppercase; letter-spacing: 0.5px;
                                              padding: 6px 8px; text-align: left; }
                    .dd table.grid tbody td { padding: 6px 8px; border-bottom: 1px solid #e5e7eb;
                                              font-size: 9pt; }
                    .dd table.grid tbody tr:nth-child(even) td { background: #f9fafb; }
                    .dd .num { text-align: right; }
                    .dd .sec-title { font-size: 8pt; font-weight: 700; color: #374151;
                                     text-transform: uppercase; letter-spacing: 1px;
                                     margin: 14px 0 5px 0; }

                    .dd .note-box { background: #fffbeb; border: 1px solid #fde68a;
                                    padding: 8px 12px; font-size: 8.5pt; color: #78350f;
                                    line-height: 1.45; }
                    .dd .footnote { font-size: 7.5pt; color: #6b7280; line-height: 1.45;
                                    margin-top: 8px; }
                    .dd .sig-line { border-top: 1px solid #9ca3af; margin-top: 34px;
                                    padding-top: 3px; font-size: 7.5pt; color: #6b7280; }
                    .dd .sig-title { font-size: 9pt; font-weight: 700; color: #111827; }
                </style>

                <t t-call="web.external_layout">
                    <div class="page dd">
                        <div class="row mb-4">
                            <div class="col-7">
                                <div class="doc-ref">
                                    <span t-out="o.name"/>
                                </div>
                                <div class="doc-sub">
                                    Goods loaded on this document are dispatched to the
                                    customers listed below.
                                </div>
                            </div>
                            <div class="col-5">
                                <div class="doc-meta">
                                    <p>
                                        <span class="m-lbl">Generated by</span><br/>
                                        <strong t-out="o.generated_by_id.name"/>
                                    </p>
                                    <p>
                                        <span class="m-lbl">Generated on</span><br/>
                                        <span t-field="o.generated_at"/>
                                    </p>
                                    <p>
                                        <span class="m-lbl">Invoices on the truck</span><br/>
                                        <strong t-out="o.invoice_count"/>
                                    </p>
                                </div>
                            </div>
                        </div>

                        <!-- t-att-class replaces the static class entirely in
                             server-side QWeb (ir_qweb assigns attrs[name] with
                             no class merging), so the whole class string lives
                             in the expression. -->
                        <table t-att-class="'kpi has-pallets' if o.pallet_ids else 'kpi'"
                               cellspacing="0" cellpadding="0" style="width: 100%;">
                            <tr>
                                <td>
                                    <div class="k-lbl">Load Weight</div>
                                    <div class="k-val">
                                        <span t-field="o.total_load_weight"/>
                                        <span t-out="o.weight_uom_name"/>
                                    </div>
                                    <!-- Catalogue weights are often blank, so
                                         show how the figure is made up. -->
                                    <div class="k-sub" t-if="o.pallet_ids">
                                        goods <span t-field="o.total_weight"/>
                                        + pallets
                                        <span t-field="o.total_pallet_weight"/>
                                    </div>
                                </td>
                                <td t-if="o.pallet_ids">
                                    <div class="k-lbl">Pallets</div>
                                    <div class="k-val">
                                        <span t-field="o.total_pallet_quantity"/>
                                    </div>
                                    <div class="k-sub">
                                        <span t-field="o.total_pallet_weight"/>
                                        <span t-out="o.weight_uom_name"/>
                                    </div>
                                </td>
                                <td>
                                    <div class="k-lbl">Total Value</div>
                                    <div class="k-val">
                                        <span t-field="o.total_value"
                                              t-options="{'widget': 'monetary',
                                                          'display_currency': o.currency_id}"/>
                                    </div>
                                </td>
                                <td>
                                    <div class="k-lbl">Paid Upfront</div>
                                    <div class="k-val pos">
                                        <span t-field="o.paid_upfront_amount"
                                              t-options="{'widget': 'monetary',
                                                          'display_currency': o.currency_id}"/>
                                    </div>
                                </td>
                                <td>
                                    <div class="k-lbl">On Account</div>
                                    <div class="k-val neg">
                                        <span t-field="o.on_account_amount"
                                              t-options="{'widget': 'monetary',
                                                          'display_currency': o.currency_id}"/>
                                    </div>
                                </td>
                            </tr>
                        </table>

                        <div class="sec-title">Invoices on this truck</div>
                        <table class="grid" cellspacing="0" cellpadding="0">
                            <thead>
                                <tr>
                                    <th>Invoice</th>
                                    <th>Customer</th>
                                    <th>Date</th>
                                    <th class="num">Invoice Value</th>
                                    <th class="num">Paid Upfront</th>
                                    <th class="num">On Account</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o._get_delivery_invoices()" t-as="invoice">
                                    <td>
                                        <strong t-out="invoice.name if invoice.name and invoice.name != '/' else 'Draft'"/>
                                    </td>
                                    <td t-out="invoice.partner_id.display_name"/>
                                    <td>
                                        <span t-field="invoice.invoice_date"/>
                                    </td>
                                    <td class="num">
                                        <span t-field="invoice.amount_total"
                                              t-options="{'widget': 'monetary',
                                                          'display_currency': invoice.currency_id}"/>
                                    </td>
                                    <td class="num">
                                        <span t-out="'%.2f' % (invoice.amount_total - invoice.amount_residual)"/>
                                    </td>
                                    <td class="num">
                                        <span t-field="invoice.amount_residual"
                                              t-options="{'widget': 'monetary',
                                                          'display_currency': invoice.currency_id}"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <div class="sec-title">Load by product</div>
                        <table class="grid" cellspacing="0" cellpadding="0">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th>Code</th>
                                    <th class="num">Quantity</th>
                                    <th>Unit</th>
                                    <th class="num">Unit Weight</th>
                                    <th class="num">Line Weight</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.get_weight_lines()" t-as="line">
                                    <td t-out="line.product.display_name"/>
                                    <td t-out="line.product.default_code or ''"/>
                                    <td class="num" t-out="line.quantity_display"/>
                                    <td t-out="line.uom.name"/>
                                    <td class="num" t-out="'%s %s / unit' % (line.unit_weight, o.weight_uom_name)"/>
                                    <td class="num">
                                        <strong t-out="line.weight_display"/>
                                        <span t-out="o.weight_uom_name"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <t t-if="o.pallet_ids">
                            <div class="sec-title">Pallets</div>
                            <table class="grid" cellspacing="0" cellpadding="0">
                                <thead>
                                    <tr>
                                        <th>Pallet</th>
                                        <th class="num">Quantity</th>
                                        <th class="num">Weight per Pallet</th>
                                        <th class="num">Line Weight</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="o.pallet_ids.get_pallet_lines()"
                                        t-as="pallet">
                                        <td t-out="pallet.name"/>
                                        <td class="num" t-out="pallet.quantity_display"/>
                                        <td class="num">
                                            <span t-out="pallet.weight_per_pallet"/>
                                            <span t-out="o.weight_uom_name"/>
                                        </td>
                                        <td class="num">
                                            <strong t-out="pallet.line_weight_display"/>
                                            <span t-out="o.weight_uom_name"/>
                                        </td>
                                    </tr>
                                    <tr style="border-top: 2px solid #111827;">
                                        <td><strong>Total</strong></td>
                                        <td class="num">
                                            <strong t-field="o.total_pallet_quantity"/>
                                        </td>
                                        <td/>
                                        <td class="num">
                                            <strong t-field="o.total_pallet_weight"/>
                                            <span t-out="o.weight_uom_name"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </t>

                        <div t-if="o.note" class="note-box" style="margin-top: 12px;">
                            <strong>Notes</strong><br/>
                            <span t-out="o.note"/>
                        </div>

                        <p class="footnote">
                            Quantities and weights are consolidated across every invoice
                            on this document. This document records what was loaded onto
                            the truck: it reserves, moves and posts nothing.
                            <t t-if="o.pallet_ids">
                                <strong>Load Weight</strong> is the goods weight plus the
                                pallet weight, so both are counted exactly once. Product
                                weights in the catalogue are often blank, which is why the
                                <strong>Pallets</strong> section lets dispatch record what
                                the scale actually says.
                            </t>
                        </p>

                        <table style="width: 100%; margin-top: 10px;" cellspacing="0" cellpadding="0">
                            <tr>
                                <td width="32%">
                                    <div class="sig-title">Loaded by</div>
                                    <div class="sig-line">Name / signature</div>
                                </td>
                                <td width="4%"/>
                                <td width="32%">
                                    <div class="sig-title">Dispatched by</div>
                                    <div class="sig-line">Name / signature</div>
                                </td>
                                <td width="4%"/>
                                <td width="28%">
                                    <div class="sig-title">Received by</div>
                                    <div class="sig-line">Name / signature</div>
                                </td>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_delivery_document" model="ir.actions.report">
        <field name="name">Delivery Document</field>
        <field name="model">vuma.delivery.document</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">vuma_picking_slip.report_delivery_document</field>
        <field name="print_report_name">'Delivery Document - %s' % (object.name or '')</field>
        <field name="binding_model_id" ref="model_vuma_delivery_document"/>
        <field name="binding_type">report</field>
    </record>

</odoo>
