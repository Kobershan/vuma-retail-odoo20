<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        The button lives on the customer invoice list because that is where a
        user selects several invoices. A list <header> button runs the method
        once against the whole selection.
    -->
    <record id="view_out_invoice_tree_inherit_vuma_picking_slip" model="ir.ui.view">
        <field name="name">account.out.invoice.list.vuma.picking.slip</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[1]" position="before">
                <header>
                    <button name="action_create_consolidated_picking_slip"
                            type="object"
                            string="Create Picking Slip"
                            class="btn-primary"/>
                    <button name="action_print_consolidated_picking_slip"
                            type="object"
                            string="Print Picking PDF"
                            class="btn-secondary"/>
                    <button name="action_create_delivery_document"
                            type="object"
                            string="Create Delivery Document"
                            class="btn-primary"/>
                </header>
            </xpath>
        </field>
    </record>

</odoo>
