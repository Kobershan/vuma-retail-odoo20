<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ======================================================== list view -->
    <record id="view_vuma_delivery_document_list" model="ir.ui.view">
        <field name="name">vuma.delivery.document.list</field>
        <field name="model">vuma.delivery.document</field>
        <field name="arch" type="xml">
            <list string="Delivery Documents">
                <field name="name"/>
                <field name="generated_at"/>
                <field name="generated_by_id" widget="many2one_avatar_user"/>
                <field name="source_company_ids" widget="many2many_tags"
                       optional="show"/>
                <field name="invoice_count" string="Invoices"/>
                <field name="total_weight" sum="Product Weight"
                       optional="show"/>
                <field name="total_pallet_quantity" sum="Pallets"
                       optional="show"/>
                <field name="total_pallet_weight" string="Pallet Weight"
                       sum="Pallet Weight" optional="show"/>
                <field name="total_box_quantity" sum="Boxes"
                       optional="show"/>
                <field name="total_box_weight" string="Box Weight"
                       sum="Box Weight" optional="show"/>
                <field name="total_load_weight" sum="Total Weight"/>
                <field name="weight_uom_name" optional="hide"/>
                <field name="cash_invoice_count" string="Cash Invoices"
                       optional="hide"/>
                <field name="on_account_invoice_count"
                       string="On Account Invoices" optional="hide"/>
                <field name="paid_upfront_amount" sum="Cash"/>
                <field name="on_account_amount" sum="On Account"/>
                <field name="total_value" sum="Total Value"/>
                <field name="vehicle_id" optional="hide"/>
                <field name="driver_id" optional="hide"/>
                <field name="multi_company" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="company_id" groups="base.group_multi_company"
                       optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ======================================================== form view -->
    <record id="view_vuma_delivery_document_form" model="ir.ui.view">
        <field name="name">vuma.delivery.document.form</field>
        <field name="model">vuma.delivery.document</field>
        <field name="arch" type="xml">
            <form string="Delivery Document">
                <header>
                    <button name="action_print_pdf" type="object"
                            string="Print Delivery Document"
                            class="oe_highlight"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_invoices" type="object"
                                class="oe_stat_button" icon="fa-file-text-o">
                            <field name="invoice_count" widget="statinfo"
                                   string="Invoices"/>
                        </button>
                        <button name="action_view_on_account_invoices"
                                type="object" class="oe_stat_button"
                                icon="fa-clock-o">
                            <field name="on_account_invoice_count"
                                   widget="statinfo" string="On Account"/>
                        </button>
                        <button name="action_view_cash_invoices" type="object"
                                class="oe_stat_button" icon="fa-money">
                            <field name="cash_invoice_count" widget="statinfo"
                                   string="Cash"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <group>
                        <group string="Document">
                            <field name="generated_at"/>
                            <field name="generated_by_id"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                            <field name="source_company_ids"
                                   widget="many2many_tags" readonly="1"/>
                            <field name="multi_company" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Invoice Values">
                            <field name="total_value"/>
                            <field name="paid_upfront_amount"/>
                            <field name="on_account_amount"/>
                        </group>
                    </group>

                    <group string="Load and Weight">
                        <group>
                            <label for="total_weight"
                                   string="Total Product Weight"/>
                            <div class="o_row">
                                <field name="total_weight" class="oe_inline"/>
                                <field name="weight_uom_name"
                                       class="oe_inline" readonly="1"/>
                            </div>
                            <label for="total_pallet_quantity"
                                   string="Pallets"/>
                            <div class="o_row">
                                <field name="total_pallet_quantity"
                                       class="oe_inline"/>
                                <span class="oe_inline">pallets weighing</span>
                                <field name="total_pallet_weight"
                                       class="oe_inline"/>
                                <field name="weight_uom_name"
                                       class="oe_inline" readonly="1"/>
                            </div>
                            <label for="total_box_quantity" string="Boxes"/>
                            <div class="o_row">
                                <field name="total_box_quantity"
                                       class="oe_inline"/>
                                <span class="oe_inline">boxes weighing</span>
                                <field name="total_box_weight"
                                       class="oe_inline"/>
                                <field name="weight_uom_name"
                                       class="oe_inline" readonly="1"/>
                            </div>
                        </group>
                        <group>
                            <label for="total_load_weight"
                                   string="Total Weight"/>
                            <div class="o_row">
                                <field name="total_load_weight"
                                       class="oe_inline"/>
                                <field name="weight_uom_name"
                                       class="oe_inline" readonly="1"/>
                            </div>
                            <div class="text-muted">
                                Product weight + pallet weight + box weight,
                                each counted exactly once.
                            </div>
                        </group>
                    </group>

                    <group string="Truck and Crew">
                        <group>
                            <field name="vehicle_id"
                                   options="{'no_create': True}"/>
                            <field name="driver_id"
                                   options="{'no_create': True}"/>
                        </group>
                        <group>
                            <!-- The driver is excluded so the same person
                                 cannot be counted twice on one truck. -->
                            <field name="helper_ids" widget="many2many_tags"
                                   options="{'no_create': True}"
                                   domain="[('id', '!=', driver_id)]"/>
                            <field name="crew_count"/>
                        </group>
                    </group>

                    <div class="alert alert-info" role="alert">
                        <strong>Cash</strong> is the invoice value already paid
                        (cash or immediate payment). <strong>On Account</strong>
                        is the value still owing. Fully paid invoices appear
                        only under Cash, unpaid invoices only under On Account,
                        and a part-paid invoice appears in both: its paid
                        portion under Cash and its balance under On Account.
                        <strong>Total Invoice Value</strong> is the two together.
                    </div>

                    <notebook>
                        <page string="Invoices on the Truck" name="invoices">
                            <field name="invoice_ids"
                                   domain="[('move_type', '=', 'out_invoice'), ('state', '!=', 'cancel')]">
                                <list create="false">
                                    <field name="name"/>
                                    <field name="partner_id"/>
                                    <field name="company_id"
                                           optional="show"/>
                                    <field name="invoice_date"/>
                                    <field name="payment_state" widget="badge"/>
                                    <field name="state"/>
                                    <field name="amount_total" sum="Total"/>
                                    <field name="amount_residual"
                                           sum="On Account"/>
                                    <field name="currency_id"
                                           column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Pallets" name="pallets">
                            <field name="pallet_ids">
                                <list editable="bottom" create="true"
                                      delete="true">
                                    <field name="sequence" column_invisible="1"/>
                                    <field name="name"
                                           placeholder="e.g. Cola 2L -- Shoprite"/>
                                    <field name="quantity" sum="Total"/>
                                    <field name="weight_per_pallet"/>
                                    <field name="line_weight" sum="Pallet Weight"/>
                                </list>
                            </field>
                            <div class="alert alert-info mt-2" role="alert">
                                Count the pallets physically loaded and enter
                                how much each one weighs.
                                <strong>Total Weight</strong> (under
                                <strong>Load and Weight</strong>, and on the
                                printed document) is
                                <em>product + pallets + boxes</em>, each counted
                                exactly once. Product weights in the catalogue
                                are often blank, which is why the pallet figure
                                matters.
                            </div>
                        </page>
                        <page string="Boxes" name="boxes">
                            <field name="box_ids">
                                <list editable="bottom" create="true"
                                      delete="true">
                                    <field name="sequence" column_invisible="1"/>
                                    <field name="name"
                                           placeholder="e.g. Soap -- 12 per carton"/>
                                    <field name="quantity" sum="Total"/>
                                    <field name="weight_per_box"/>
                                    <field name="line_weight" sum="Box Weight"/>
                                </list>
                            </field>
                            <div class="alert alert-info mt-2" role="alert">
                                Count the cardboard boxes physically loaded
                                and enter how much each one weighs.
                                <strong>Total Weight</strong> (under
                                <strong>Load and Weight</strong>, and on the
                                printed document) is
                                <em>product + pallets + boxes</em>, each counted
                                exactly once.
                            </div>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note"
                                   placeholder="Anything dispatch or the driver should know about this truck load..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ====================================================== search view -->
    <record id="view_vuma_delivery_document_search" model="ir.ui.view">
        <field name="name">vuma.delivery.document.search</field>
        <field name="model">vuma.delivery.document</field>
        <field name="arch" type="xml">
            <search string="Delivery Documents">
                <field name="name" string="Delivery Document"/>
                <field name="invoice_ids" string="Invoice"/>
                <field name="generated_by_id"/>
                <filter name="filter_today" string="Generated Today"
                        domain="[('generated_at', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00'))]"/>
                <filter name="filter_my_documents" string="Generated by Me"
                        domain="[('generated_by_id', '=', uid)]"/>
                <filter name="filter_cash" string="Has Cash"
                        domain="[('paid_upfront_amount', '!=', 0)]"/>
                <filter name="filter_on_account" string="Has On Account"
                        domain="[('on_account_amount', '!=', 0)]"/>
                <separator/>
                <group>
                    <filter name="group_generated_by" string="Generated By"
                            context="{'group_by': 'generated_by_id'}"/>
                    <filter name="group_generated_date" string="Generated On"
                            context="{'group_by': 'generated_at:day'}"/>
                    <filter name="group_company" string="Company"
                            context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ================================================== document actions -->
    <record id="action_delivery_document" model="ir.actions.act_window">
        <field name="name">Delivery Documents</field>
        <field name="res_model">vuma.delivery.document</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a document for one truck load
            </p>
            <p>
                Select the invoices going on the truck in
                <strong>Sales &gt; Invoicing &gt; Customer Invoices</strong>
                and press <strong>Create Delivery Document</strong>.
                A load may contain invoices from both Trade Rite and
                Siyaya DC.
            </p>
        </field>
    </record>

    <!-- ====================================================== Sales menu -->
    <menuitem id="menu_delivery_document" name="Delivery Documents"
              parent="sale.sale_menu_root" action="action_delivery_document"
              sequence="16"
              groups="sales_team.group_sale_salesman,stock.group_stock_user"/>

</odoo>