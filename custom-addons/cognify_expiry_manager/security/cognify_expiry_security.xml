<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!--
            Grants the expiry menu and the alert buttons on top of the standard
            "User" stock rights, so a warehouse clerk sees expiring goods without
            needing full stock administrator access.
        -->
        <record id="group_expiry_user" model="res.groups">
            <field name="name">Expiry Alerts</field>
            <field name="privilege_id" ref="stock.res_groups_privilege_inventory"/>
            <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
        </record>

        <!--
            Lets a responsible manager re-run the scan and clear the alert
            history, e.g. after a stock count or when changing a window.
        -->
        <record id="group_expiry_manager" model="res.groups">
            <field name="name">Expiry Alerts Manager</field>
            <field name="privilege_id" ref="stock.res_groups_privilege_inventory"/>
            <field name="implied_ids" eval="[(4, ref('cognify_expiry_manager.group_expiry_user'))]"/>
        </record>

        <!-- `(4, ...)` appends, so the stock manager's own user group is kept. -->
        <record id="stock.group_stock_manager" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('cognify_expiry_manager.group_expiry_manager'))]"/>
        </record>

    </data>
</odoo>