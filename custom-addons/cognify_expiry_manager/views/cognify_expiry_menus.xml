<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_expiry_alerts" model="ir.actions.act_window">
        <field name="name">Expiry Alerts</field>
        <field name="res_model">stock.lot</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('product_qty', '&gt;', 0), ('expiration_date', '!=', False), '|', ('alert_date', '&lt;=', time.strftime('%Y-%m-%d %H:%M:%S')), ('expiration_date', '&lt;=', time.strftime('%Y-%m-%d %H:%M:%S'))]</field>
        <field name="context">{'create': False, 'search_default_filter_on_hand': 1, 'search_default_filter_alert_window': 1}</field>
        <field name="view_id" ref="stock_lot_view_expiry_tree"/>
        <field name="search_view_id" ref="stock_lot_view_expiry_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing is expiring</p>
            <p>Stock appears here once a lot enters its product's alert window, or after it has expired.</p>
        </field>
    </record>

    <record id="action_scan_expiry_alerts" model="ir.actions.server">
        <field name="name">Re-scan expiry alerts</field>
        <field name="model_id" ref="stock.model_stock_lot"/>
        <field name="state">code</field>
        <field name="code">action = model._notify_expiry_alerts()</field>
        <field name="group_ids" eval="[(4, ref('cognify_expiry_manager.group_expiry_manager'))]"/>
    </record>

    <!-- Inventory > Expiry Alerts, sitting next to the other inventory tooling. -->
    <menuitem id="menu_expiry_alerts"
              name="Expiry Alerts"
              parent="stock.menu_stock_root"
              action="action_expiry_alerts"
              sequence="12"
              groups="cognify_expiry_manager.group_expiry_user"/>

    <menuitem id="menu_expiry_scan"
              name="Re-scan Expiry Alerts"
              parent="cognify_expiry_manager.menu_expiry_alerts"
              action="action_scan_expiry_alerts"
              sequence="20"
              groups="cognify_expiry_manager.group_expiry_manager"/>

    <menuitem id="menu_expiry_report"
              name="Expiry Report"
              parent="stock.menu_stock_root"
              action="cognify_expiry_manager.action_report_expiry_stock"
              sequence="13"
              groups="cognify_expiry_manager.group_expiry_user"/>

</odoo>