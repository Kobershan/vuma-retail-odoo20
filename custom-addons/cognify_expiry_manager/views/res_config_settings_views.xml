<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_inherit_cognify_expiry" model="ir.ui.view">
        <field name="name">res.config.settings.inherit.cognify.expiry</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//block[@name='shipping_setting_container']" position="after">
                <block title="Expiry Alerts" name="cognify_expiry_alerts_setting_container">
                    <setting id="cognify_expiry_recipients"
                             string="Alert Recipients"
                             help="These users are told, in addition to each product's Responsible user, when stock enters its alert window.">
                        <field name="cognify_notify_user_ids" widget="many2many_tags"
                               placeholder="Add a user..."/>
                    </setting>
                    <setting id="cognify_expiry_channels" string="Notify via"
                             help="Which channels raise the alert. Any combination can be switched off.">
                        <div class="content-group">
                            <div class="row mt8">
                                <field name="cognify_enable_bus_notifications" class="col-lg-1 o_light_label"/>
                                <label for="cognify_enable_bus_notifications" class="col-lg-11 o_light_label">
                                    In-app popup
                                </label>
                            </div>
                            <div class="row mt8">
                                <field name="cognify_enable_activity_notifications" class="col-lg-1 o_light_label"/>
                                <label for="cognify_enable_activity_notifications" class="col-lg-11 o_light_label">
                                    Activity on the lot
                                </label>
                            </div>
                            <div class="row mt8">
                                <field name="cognify_enable_email_notifications" class="col-lg-1 o_light_label"/>
                                <label for="cognify_enable_email_notifications" class="col-lg-11 o_light_label">
                                    Email (needs an outgoing mail server)
                                </label>
                            </div>
                        </div>
                    </setting>
                    <setting id="cognify_expiry_delivery_slip"
                             string="Expiry on Delivery Slips"
                             help="Adds the Expiry Date column to printed picking slips. Both this and 'Display Lots and Serial Numbers' must be on for the column to appear.">
                        <div class="content-group">
                            <div class="row mt8">
                                <field name="group_expiry_date_on_delivery_slip" class="col-lg-1 o_light_label"/>
                                <label for="group_expiry_date_on_delivery_slip" class="col-lg-11 o_light_label">
                                    Display Expiration Dates
                                </label>
                            </div>
                            <div class="row mt8">
                                <field name="group_lot_on_delivery_slip" class="col-lg-1 o_light_label"/>
                                <label for="group_lot_on_delivery_slip" class="col-lg-11 o_light_label">
                                    Display Lots &amp; Serial Numbers
                                </label>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>

        </field>
    </record>

</odoo>