<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Access model (Odoo 20 merged ir.rule into ir.access — see ir.access.csv,
        where a row scoped to a group acts as that group's permission and its
        ``domain`` is what narrows the group down):

          Rep       creates and submits their own remittances. Implied by the
                    standard Salesman group, so every existing rep gets it.
                    The CSV row restricts them to remittances where they are
                    the rep.
          Approver  the office side. Verifies, rejects and credits to the books.
                    Implied by Accounting (User), so any accountant qualifies.
                    No domain — office sees every remittance.
    -->

    <record id="group_cognify_remittance_rep" model="res.groups">
        <field name="name">Remittance: Field Rep</field>
        <field name="privilege_id" ref="sales_team.res_groups_privilege_sales"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="comment">Create and submit personal field remittances.</field>
    </record>

    <record id="group_cognify_remittance_approver" model="res.groups">
        <field name="name">Remittance: Office Approver</field>
        <field name="privilege_id" ref="account.res_groups_privilege_accounting"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_user'))]"/>
        <field name="comment">Verify field remittances and credit them to the accounts.</field>
    </record>

</odoo>
