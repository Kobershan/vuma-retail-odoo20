<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="account_move_form_inherit_customer_goods_pickup" model="ir.ui.view">
        <field name="name">account.move.inherit.customer.goods.pickup.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button name="action_view_goods_pickup" type="object"
                        class="oe_stat_button" icon="fa-reply"
                        invisible="not goods_pickup_id"
                        groups="customer_goods_pickup.group_goods_pickup_store_receiver">
                    <field name="goods_pickup_id" widget="statinfo" string="Pickup"/>
                </button>
                <button name="action_view_goods_receipt" type="object"
                        class="oe_stat_button" icon="fa-truck"
                        invisible="not goods_pickup_receipt_id"
                        groups="customer_goods_pickup.group_goods_pickup_store_receiver">
                    <field name="goods_pickup_receipt_id" widget="statinfo"
                           string="Store Receipt"/>
                </button>
            </xpath>

            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='price_unit']"
                   position="before">
                <field name="goods_pickup_receipt_line_id" column_invisible="1"/>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Goods Pickup" name="goods_pickup"
                      invisible="not goods_pickup_id">
                    <group>
                        <group>
                            <field name="goods_pickup_id"/>
                            <field name="goods_pickup_receipt_id"/>
                        </group>
                        <group>
                            <field name="goods_pickup_partner_id"/>
                            <field name="goods_pickup_invoice_number"/>
                            <field name="reversed_entry_id"/>
                        </group>
                    </group>
                </page>
            </xpath>

        </field>
    </record>

</odoo>