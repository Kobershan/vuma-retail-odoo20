<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_picking_form_inherit_customer_goods_pickup" model="ir.ui.view">
        <field name="name">stock.picking.inherit.customer.goods.pickup.form</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">

            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button name="action_view_goods_receipt" type="object"
                        class="oe_stat_button" icon="fa-reply"
                        invisible="not goods_receipt_id"
                        groups="customer_goods_pickup.group_goods_pickup_store_receiver">
                    <field name="goods_receipt_id" widget="statinfo"
                           string="Store Receipt"/>
                </button>
                <button name="action_view_goods_pickup" type="object"
                        class="oe_stat_button" icon="fa-tags"
                        invisible="not goods_pickup_id"
                        groups="customer_goods_pickup.group_goods_pickup_store_receiver">
                    <field name="goods_pickup_id" widget="statinfo"
                           string="Goods Pickup"/>
                </button>
            </xpath>

            <!-- The original invoice number sits right under the source
                 document, so a store clerk never has to guess which sale the
                 goods on the trolley came back from. -->
            <xpath expr="//field[@name='date_done']" position="after">
                <field name="goods_invoice_number" readonly="1"
                       invisible="not goods_invoice_number"/>
            </xpath>

        </field>
    </record>

</odoo>