<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_inherit_customer_goods_pickup" model="ir.ui.view">
        <field name="name">res.config.settings.inherit.customer.goods.pickup</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//block[@name='operations_setting_container']" position="after">
                <block title="Customer Goods Pickup" name="customer_goods_pickup_container">
                    <setting id="cognify_goods_quarantine_location_id"
                             string="Quarantine Location"
                             help="Where goods the store refused are physically received. Leave empty and the module keeps its own structure under Customer Returns. Whatever you choose must be an internal location outside every warehouse: stock inside a warehouse counts towards the quantity on hand and can be reserved for a customer order.">
                        <field name="cognify_goods_quarantine_location_id"
                               options="{'no_create': True}"/>
                        <div class="content-group mt16" colspan="2">
                            <span class="text-muted">
                                <field name="cognify_goods_quarantine_location_state"
                                       nolabel="1" readonly="1"/>
                            </span>
                            <button name="action_open_quarantine_setup" type="object"
                                    string="Create / Open The Returns Area"
                                    class="btn-link"
                                    groups="base.group_system"/>
                        </div>
                    </setting>
                    <setting id="cognify_goods_pickup_notify_rep"
                             string="Notify The Sales Representative"
                             help="Post a message on the pickup, mentioning the representative, every time the store finishes receiving it.">
                        <field name="cognify_goods_pickup_notify_rep"/>
                    </setting>
                </block>
            </xpath>

        </field>
    </record>

</odoo>