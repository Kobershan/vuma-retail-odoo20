<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Access model (Odoo 20 merged ir.rule into ir.access — see ir.access.csv,
        where a row scoped to a group acts as that group's permission and its
        ``domain`` is what narrows the group down):

          Sales rep     raises the pickup against a posted invoice and confirms
                        collection. Implied by the standard Salesman group, so
                        every existing rep gets it, plus read-only accounting
                        so the invoice can actually be chosen and checked. The
                        CSV row restricts them to pickups they own.
          Store         counts, inspects and accepts, part-accepts or rejects at
                        the counter, and validates the stock transfer. Implied
                        by the standard stock User group, plus read-only
                        accounting so the original invoice can be verified at
                        the counter. They never see the credit buttons.
          Accountant    reviews accepted quantity and raises the credit note.
                        Implied by Accounting (Invoice), so the posting right
                        itself stays exactly where Odoo puts it.
          Manager       everything above, plus authorised corrections: cancelling
                        a confirmed pickup, reversing a validated receipt, and
                        releasing a held credit.
    -->

    <record id="group_goods_pickup_sales_rep" model="res.groups">
        <field name="name">Goods Pickup: Sales Representative</field>
        <field name="privilege_id" ref="sales_team.res_groups_privilege_sales"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman')),
                                        (4, ref('account.group_account_readonly'))]"/>
        <field name="comment">Create goods pickups against a posted customer invoice and confirm collection.</field>
    </record>

    <record id="group_goods_pickup_store_receiver" model="res.groups">
        <field name="name">Goods Pickup: Store Receiving</field>
        <field name="privilege_id" ref="stock.res_groups_privilege_inventory"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user')),
                                        (4, ref('account.group_account_readonly'))]"/>
        <field name="comment">Receive, inspect, accept, part-accept or reject collected goods.</field>
    </record>

    <record id="group_goods_pickup_accountant" model="res.groups">
        <field name="name">Goods Pickup: Accountant</field>
        <field name="privilege_id" ref="account.res_groups_privilege_accounting"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
        <field name="comment">Approve accepted quantities and raise the customer credit note.</field>
    </record>

    <!--
        The manager group deliberately does NOT imply base.group_system.
        It grants the store and accountant groups, and reversing a stock
        receipt only needs the standard inventory rights. Implying the system
        administrator group was a privilege escalation: Odoo 20 hands every new
        user base.default_user_group, which in a standard retail install
        contains the inventory administrator, so every employee created in
        Inventory &gt; Users became a goods pickup manager with full system
        rights.
    -->
    <record id="group_goods_pickup_manager" model="res.groups">
        <field name="name">Goods Pickup: Manager</field>
        <field name="privilege_id" ref="stock.res_groups_privilege_inventory"/>
        <!--
            The unlink command below removes an implication. On a database
            where this module is already installed, a link added by an earlier
            version stays in place unless it is explicitly taken away, and it
            is that link which escalates: base.group_system made every goods
            pickup manager a system administrator, and the reverse link made
            every inventory administrator a goods pickup manager. Odoo 20
            grants base.default_user_group to every new user, and in a
            standard retail install that group contains the inventory
            administrator, so the escalation reached every employee created in
            Inventory &gt; Users.
        -->
        <field name="implied_ids" eval="[(3, ref('base.group_system')),
                                        (4, ref('customer_goods_pickup.group_goods_pickup_store_receiver')),
                                        (4, ref('customer_goods_pickup.group_goods_pickup_accountant'))]"/>
        <field name="comment">Authorised corrections: cancel a confirmed pickup, reverse a validated receipt, release a held credit.</field>
    </record>

    <!--
        A goods pickup manager is granted explicitly, not by promoting every
        stock manager. Whoever administers this module should add the group to
        the people who actually run the counter workflow.

        The (3, ...) command *removes* the implication. On a database that
        already had this module installed, the group link added by an earlier
        version stays in place unless it is explicitly taken away, and it is
        that link which made every inventory administrator a goods pickup
        manager.
    -->
    <record id="stock.group_stock_manager" model="res.groups">
        <field name="implied_ids" eval="[(3, ref('customer_goods_pickup.group_goods_pickup_manager'))]"/>
    </record>

</odoo>