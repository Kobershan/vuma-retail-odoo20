<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!--
            Thumbnail on each purchase order line, on screen.

            The printed purchase order already shows the picture
            (report/report_purchase_order.xml); this puts the same picture in
            the order form so an order can be checked against the shelf
            without printing anything. A line whose product has no picture
            simply renders no image, exactly as the printed document does.
        -->
        <record id="purchase_order_form_line_thumbnail" model="ir.ui.view">
            <field name="name">purchase.order.form.line.thumbnail</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='order_line']/list/column[@name='product_and_description']" position="before">
                    <field name="product_image_128" widget="image"
                           class="o_po_line_thumbnail"
                           options="{'img_class': 'o_image_40_contain'}"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>