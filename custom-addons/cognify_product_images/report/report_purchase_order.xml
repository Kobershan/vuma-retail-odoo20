<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Purchase Order.

        The description cell prints line.label, a prepared string, so the
        product is read off the line itself. Lines that are a section or a note
        have no product, and lines the buyer typed without picking a product
        have none either. cognify_product_image() returns nothing for those,
        which is what keeps a description only line looking unchanged.
    -->
    <template id="report_purchaseorder_document_inherit_cognify_product_images"
              inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//td[@id='product']/span[@t-field='line.label']" position="before">
            <t t-out="cognify_product_image(line.product_id, 'purchase_order')"/>
        </xpath>
    </template>

</odoo>