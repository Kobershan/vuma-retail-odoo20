<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        A plain A4 sheet of labels. Three labels per row keeps a normal shelf
        label readable; the layout deliberately uses a table so it renders
        correctly in wkhtmltopdf as well as in the browser preview.
    -->
    <template id="report_vuma_product_label">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <div class="page">
                    <table style="width: 100%; table-layout: fixed; border-collapse: collapse;">
                        <t t-foreach="range(0, len(docs), 3)" t-as="row_start">
                            <tr>
                                <t t-foreach="docs[row_start:row_start + 3]" t-as="label">
                                    <td style="width: 33.33%; padding: 4mm; vertical-align: top;">
                                        <div t-att-style="'border: 1px solid #333; padding: 3mm; height: %s; overflow: hidden;' % ('45mm' if label.label_size == 'shelf' else ('20mm' if label.label_size == 'small' else '60mm'))">
                                            <div style="font-size: 15px; font-weight: bold; line-height: 1.15;"
                                                 t-out="label.template_id.name"/>
                                            <div style="font-size: 12px; margin-top: 1mm;"
                                                 t-out="label.name"/>
                                            <div style="font-size: 24px; font-weight: bold; margin: 1mm 0;"
                                                 t-if="label.price"
                                                 t-out="label.price_display"/>
                                            <div t-if="label.barcode"
                                                 t-out="label.barcode"
                                                 t-options="{
                                                     'widget': 'barcode',
                                                     'quiet': 0,
                                                     'symbology': 'auto',
                                                     'img_style': 'width:100%;height:10mm'
                                                 }"/>
                                            <div style="font-family: monospace; font-size: 10px; text-align: center;"
                                                 t-if="label.barcode"
                                                 t-out="label.barcode"/>
                                            <div style="font-size: 9px; margin-top: 1mm;"
                                                 t-if="label.notes"
                                                 t-out="label.notes"/>
                                            <div style="font-size: 8px; color: #666; margin-top: 1mm;"
                                                 t-if="label.template_id.vuma_department_id"
                                                 t-out="label.template_id.vuma_department_id.name"/>
                                        </div>
                                    </td>
                                </t>
                            </tr>
                        </t>
                    </table>
                </div>
            </t>
        </t>
    </template>

</odoo>
