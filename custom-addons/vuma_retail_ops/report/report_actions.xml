        <field name="report_name">vuma_retail_ops.report_dunning_letter</field>
        <field name="print_report_name">'Letter - %s' % (object.name or object.partner_id.name)</field>
        <field name="binding_model_id" ref="model_vuma_dunning_letter"/>
        <field name="binding_type">report</field>
    </record>

