<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_debtor_statement" model="ir.actions.report">
        <field name="name">Debtor Statement</field>
        <field name="model">vuma.statement.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">vuma_retail_ops.report_debtor_statement</field>
        <field name="print_report_name">'Statement - %s' % (object.partner_id.name or 'Customer')</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>

    <record id="action_report_dunning_letter" model="ir.actions.report">
        <field name="name">Debtor Letter</field>
        <field name="model">vuma.dunning.letter</field>
