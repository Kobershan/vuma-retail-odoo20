<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_purchaseorder_document_vuma_supplier_code"
              inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//td[@id='product']/span[@t-field='line.label']"
               position="after">
            <div t-if="line.vuma_supplier_code" class="text-muted small">
                Supplier Code:
                <span t-field="line.vuma_supplier_code"/>
            </div>
        </xpath>
    </template>

    <template id="report_purchasequotation_document_vuma_supplier_code"
              inherit_id="purchase.report_purchasequotation_document">
        <xpath expr="//td[@id='product']/span[@t-field='order_line.label']"
               position="after">
            <div t-if="order_line.vuma_supplier_code" class="text-muted small">
                Supplier Code:
                <span t-field="order_line.vuma_supplier_code"/>
            </div>
        </xpath>
    </template>

</odoo>
