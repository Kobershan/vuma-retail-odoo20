<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         Shared pack-size list
         ================================================================ -->
    <record id="view_vuma_pack_size_list" model="ir.ui.view">
        <field name="name">vuma.pack.size.list</field>
        <field name="model">vuma.pack.size</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="units"/>
                <field name="default_uom_id" options="{'no_create': True}"/>
                <field name="product_count" readonly="1"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_vuma_pack_size_form" model="ir.ui.view">
        <field name="name">vuma.pack.size.form</field>
        <field name="model">vuma.pack.size</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="units"/>
                            <field name="default_uom_id"
                                   options="{'no_create': True}"/>
                            <field name="attribute_value_id"/>
                            <field name="product_count"/>
                        </group>
                    </group>
                    <div class="text-muted">
                        The default quantity and unit are copied onto an item
                        when the pack size is picked there. Change the quantity
                        or unit on the item to override it. The item can also
                        use a pack name that is not in this library.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_vuma_pack_size" model="ir.actions.act_window">
        <field name="name">Pack Sizes</field>
        <field name="res_model">vuma.pack.size</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="menu_vuma_pack_size" model="ir.ui.menu">
        <field name="name">Pack Sizes</field>
        <field name="parent_id" ref="vuma_retail_ops.menu_vuma_warehouse"/>
        <field name="action" ref="action_vuma_pack_size"/>
        <field name="sequence">40</field>
    </record>

    <record id="menu_vuma_pack_size_config" model="ir.ui.menu">
        <field name="name">Pack Sizes</field>
        <field name="parent_id" ref="stock.menu_stock_config_settings"/>
        <field name="action" ref="action_vuma_pack_size"/>
        <field name="sequence">120</field>
    </record>

    <!-- ================================================================
         Product template: Pack Sizes tab
         ================================================================ -->
    <record id="product_template_form_view_vuma_pack_sizes" model="ir.ui.view">
        <field name="name">product.template.form.vuma.pack.sizes</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='inventory']" position="after">
                <page string="Pack Sizes" name="vuma_pack_sizes"
                      invisible="type == 'service'">
                    <group>
                        <group>
                            <field name="vuma_has_pack_sizes" invisible="1"/>
                            <field name="vuma_pack_count" invisible="1"/>
                            <field name="vuma_pack_summary" readonly="1"
                                   string="Configured"/>
                        </group>
                        <group>
                            <button name="action_add_standard_pack_sizes"
                                    string="Add Standard Pack Sizes"
                                    type="object" class="btn-secondary"
                                    colspan="2"/>
                            <button name="action_apply_pack_sizes"
                                    string="Apply to Variants"
                                    type="object" class="btn-primary"
                                    colspan="2"/>
                        </group>
                    </group>
                    <field name="vuma_pack_line_ids">
                        <list editable="bottom"
                              decoration-danger="units_per_pack == 0"
                              decoration-warning="price == 0">
                            <field name="sequence" widget="handle"/>
                            <field name="name" required="1"/>
                            <field name="pack_qty"/>
                            <field name="pack_uom_id"
                                   options="{'no_create': True}"/>
                            <field name="units_per_pack" readonly="1"/>
                            <field name="price" widget="monetary"
                                   options="{'currency_field': 'currency_id'}"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="barcode"/>
                            <field name="pack_size_id" optional="hide"
                                   options="{'no_open': True}"/>
                            <field name="product_count" readonly="1"
                                   optional="hide"/>
                            <field name="qty_available" readonly="1"/>
                            <field name="single_equivalent_qty" readonly="1"/>
                        </list>
                    </field>
                    <div class="text-muted mt-2">
                        Save the pack the way it comes: type the name and its
                        own quantity and unit, for example <b>50ml</b>,
                        <b>500ml</b>, <b>1L</b>, <b>25L</b>, <b>Pallet</b> or
                        <b>Box of 37</b>. The base quantity is converted to the
                        item's stock unit when the units are compatible.
                        Each pack size becomes its own stock-keeping variant,
                        with its own stock count, barcode and selling price.
                        On an existing item add <b>Single</b> first to keep the
                        current stock on the single-unit variant. Manage pack
                        sizes here rather than in <i>Attributes &amp; Variants</i>.
                        Pick a <i>Saved Pack</i> only to copy a pack you
                        already use; typing a new name is enough.
                    </div>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Product list: show the configured pack sizes at a glance -->
    <record id="product_template_tree_view_vuma_pack_sizes" model="ir.ui.view">
        <field name="name">product.template.list.vuma.pack.sizes</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='uom_id']" position="after">
                <field name="vuma_pack_summary" string="Pack Sizes"
                       optional="hide" readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="product_template_search_view_vuma_pack_sizes" model="ir.ui.view">
        <field name="name">product.template.search.vuma.pack.sizes</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='filter_to_sell']" position="after">
                <filter string="Has Pack Sizes" name="vuma_has_pack_sizes"
                        domain="[('vuma_has_pack_sizes', '=', True)]"/>
            </xpath>
        </field>
    </record>

    <!-- ================================================================
         Product variant: the pack-size fields
         ================================================================ -->
    <record id="product_normal_form_view_vuma_pack_sizes" model="ir.ui.view">
        <field name="name">product.product.form.vuma.pack.sizes</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='vuma_pack_sizes']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='inventory']//group[@name='inventory']"
                   position="inside">
                <group name="vuma_pack_size" string="Pack Size"
                       invisible="not vuma_pack_size_id">
                    <field name="vuma_pack_size_id" readonly="1"/>
                    <field name="vuma_units_per_pack"/>
                    <field name="vuma_single_equivalent_qty" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="product_product_tree_view_vuma_pack_sizes" model="ir.ui.view">
        <field name="name">product.product.list.vuma.pack.sizes</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='uom_id']" position="after">
                <field name="vuma_pack_size_id" optional="hide" readonly="1"/>
                <field name="vuma_units_per_pack" optional="hide"/>
                <field name="vuma_single_equivalent_qty" optional="hide"
                       sum="Equivalent Singles" readonly="1"/>
            </xpath>
        </field>
    </record>

</odoo>
